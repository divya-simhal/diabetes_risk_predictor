# Copy this file to .env and fill in real values for local development.
# When running via docker-compose, these are set automatically in
# docker-compose.yml and this file is not needed.

# PostgreSQL connection string. Format:
# postgresql://<user>:<password>@<host>:<port>/<db_name>
#
# Port 5445 is used here (not the default 5432) to avoid clashing with
# another local PostgreSQL instance already running on your machine.
# This only matters when connecting from OUTSIDE Docker (e.g. running
# `uvicorn` directly on your host while the db container runs via
# docker-compose). Inside Docker, the backend talks to the db container
# over the internal network using port 5432 (see docker-compose.yml).
DATABASE_URL=postgresql://diabetes_user:diabetes_pass@localhost:5445/diabetes_db

# Generate a strong secret with: openssl rand -hex 32
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
